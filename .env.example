# Public SEO origin. Rebuild after changing this value.
NEXT_PUBLIC_SITE_URL=https://prathamaahospital.in
# Set false for any staging deployment that should stay out of search results.
SITE_INDEXABLE=true
# Optional ownership verification tokens from Google Search Console and Bing.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Callback API: exact URL supplied by the hospital ERP administrator.
# The API must accept POST { fullName, email, phone, department, message }
# and acknowledge successful storage with JSON { ok: true } or { success: true }.
ERP_CALLBACK_URL=
# Optional: server-side bearer token, if required by the ERP.
ERP_CALLBACK_TOKEN=

# Optional dedicated diagnostic booking endpoint. If left blank, diagnostic requests
# go to the existing appointment ERP with the test name in the reason field.
# A dedicated endpoint receives POST { fullName, phone, gender, department,
# appointmentDate, appointmentTime, reason, testName, email? }
# and must acknowledge receipt with JSON { ok: true } or { success: true }.
ERP_LAB_BOOKING_URL=
